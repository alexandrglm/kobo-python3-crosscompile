prefix=/home/dev/Desktop/ClaraColour/python/crosstoolsng/brotli-install
exec_prefix=/home/dev/Desktop/ClaraColour/python/crosstoolsng/brotli-install
libdir=${prefix}/lib
includedir=${prefix}/include

