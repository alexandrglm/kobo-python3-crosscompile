#!/home/dev/Desktop/ClaraColour/python/crosstoolsng/pillow-crossenv/build/bin/python3.11 -I

import os
import sys


os.environ["PYTHON_CROSSENV"] = "1728465103"

for name in [
    "_PYTHON_PROJECT_BASE",
    "_PYTHON_HOST_PLATFORM",
    "_PYTHON_SYSCONFIGDATA_NAME",
    "PYTHONHOME",
    "PYTHONPATH",
]:
    old = "_OLD_" + name
    if old not in os.environ and name in os.environ:
        os.environ[old] = os.environ[name]

os.environ["_PYTHON_PROJECT_BASE"] = '/home/dev/Desktop/ClaraColour/python/py311venv/.venvhost/bin'
os.environ["_PYTHON_HOST_PLATFORM"] = 'linux-x86_64'
os.environ["_PYTHON_SYSCONFIGDATA_NAME"] = '_sysconfigdata__linux_x86_64-linux-gnu'
os.environ["PYTHONHOME"] = '/home/dev/Desktop/ClaraColour/python/py311venv/host'
oldpath = os.environ.get("PYTHONPATH")
newpath = os.pathsep.join(
    ['/home/dev/Desktop/ClaraColour/python/crosstoolsng/pillow-crossenv/lib', '/home/dev/Desktop/ClaraColour/python/py311venv/host/lib/python3.11', '/home/dev/Desktop/ClaraColour/python/py311venv/host/lib/python3.11/lib-dynload']
)
if oldpath:
    path = os.pathsep.join([newpath, oldpath])
else:
    path = newpath

os.environ["PYTHONPATH"] = path

extra_envs = [('CPATH', ':=', '/home/dev/x-tools/arm-unknown-linux-gnueabihf/arm-unknown-linux-gnueabihf/sysroot/usr/include'), ('LIBRARY_PATH', ':=', '/home/dev/x-tools/arm-unknown-linux-gnueabihf/arm-unknown-linux-gnueabihf/sysroot/usr/libexec:/home/dev/x-tools/arm-unknown-linux-gnueabihf/arm-unknown-linux-gnueabihf/sysroot/usr/lib')]
for name, assign, value in extra_envs:
    if assign == "=":
        os.environ[name] = value
    elif assign == "?=" and name not in os.environ:
        os.environ[name] = value
    elif assign == "+=":
        os.environ[name] = os.environ.get(name, "") + value
    elif assign == ":=":
        if name in os.environ:
            os.environ[name] = os.environ[name] + ":" + value
        else:
            os.environ[name] = value

if True:
    sys.argv[1:1] = ["-X", "frozen_modules=off"]

# This will fix up argv0 so that sys.executable will be correct
os.execv('/home/dev/Desktop/ClaraColour/python/crosstoolsng/pillow-crossenv/build/bin/python3.11', sys.argv)
